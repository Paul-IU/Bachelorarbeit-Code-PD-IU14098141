<?xml version="1.0" encoding="utf-8"?>
<!--
  Bindet die von der Godot-4.7.2-Mono-Installation mitgelieferten NuGet-
  Pakete (Godot.NET.Sdk, GodotSharp, Godot.SourceGenerators) als lokale
  Paketquelle ein - dieselben Pakete, die der Godot-Editor beim ersten
  Öffnen/Bauen eines C#-Projekts sonst automatisch registriert. So baut das
  Projekt auch ohne Internetzugriff und unabhängig davon, ob der Editor das
  Projekt schon einmal geöffnet hat.

  WICHTIG bei einer anderen Godot-Version: den Pfad unten anpassen (bzw. den
  Editor das Projekt einmal öffnen lassen - er trägt die passende Quelle
  dann selbst ein) und die Sdk-Version in TacticsCoreGodot.csproj sowie
  config/features in project.godot entsprechend ändern.
-->
<configuration>
  <packageSources>
    <add key="godot-offline" value="C:\Users\20020\Desktop\BA\Godot\Godot_v4.7.2-stable_mono_win64\GodotSharp\Tools\nupkgs" />
  </packageSources>
</configuration>
